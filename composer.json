{
    "name": "asignua/filament-json-yaml-editor",
    "description": "JSON and YAML editors for Filament 5: code and tree modes, live validation with the error line, JSON Schema and symfony/yaml server-side rules, plus highlighted infolist entries.",
    "keywords": ["filament", "filament-plugin", "laravel", "json", "yaml", "json-editor", "yaml-editor", "codemirror", "json-schema"],
    "homepage": "https://github.com/asignua/filament-json-yaml-editor",
    "support": {
        "issues": "https://github.com/asignua/filament-json-yaml-editor/issues",
        "source": "https://github.com/asignua/filament-json-yaml-editor"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Mykhailo Hladchenko",
            "email": "myhailo@hotmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "phiki/phiki": "^2.2",
        "spatie/laravel-package-tools": "^1.16",
        "symfony/yaml": "^7.0|^8.0"
    },
    "require-dev": {
        "justinrainbow/json-schema": "^6.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "opis/json-schema": "^2.6",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "suggest": {
        "justinrainbow/json-schema": "Server-side JSON Schema validation (JsonSchemaRule).",
        "opis/json-schema": "Alternative engine for JsonSchemaRule (draft 2020-12)."
    },
    "autoload": {
        "psr-4": {
            "Asignua\\FilamentJsonYamlEditor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Asignua\\FilamentJsonYamlEditor\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": false
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Asignua\\FilamentJsonYamlEditor\\JsonYamlEditorServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
